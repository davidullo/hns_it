gFameCheckerFlavorText_ProfOak0:: @ 0x81AD106
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Cosa fa questa persona?\p"
	.string "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}LABORATORIO POKéMON OAK$"

gFameCheckerFlavorText_ProfOak1:: @ 0x81AD145
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Come è questa persona?\p"
	.string "{FONT_MALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Creare una guida completa su\n"
	.string "tutti i POKéMON del mondo…\p"
	.string "Era il mio sogno!$"

gFameCheckerFlavorText_ProfOak2:: @ 0x81AD1BB
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Come è questa persona?\p"
	.string "{FONT_FEMALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Il PROF. OAK non sembra granché,\n"
	.string "ma è l'autorità sui POKéMON.\p"
	.string "Molti ALLENATORI lo tengono in\n"
	.string "grande considerazione.$"

gFameCheckerFlavorText_ProfOak3:: @ 0x81AD258
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Famiglia e amici?\p"
	.string "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Il PROF. OAK vive coi nipoti,\n"
	.string "DAISY e {RIVAL}.$"

gFameCheckerFlavorText_ProfOak4:: @ 0x81AD2B9
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Famiglia e amici?\p"
	.string "{FONT_FEMALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Sento che OAK si è molto\n"
	.string "interessato a te, ragazzo.\p"
	.string "Quel vecchio era forte e\n"
	.string "affascinante.\p"
	.string "Ma decenni fa.\n"
	.string "Ora è l'ombra di sé stesso.$"

gFameCheckerFlavorText_ProfOak5:: @ 0x81AD377
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Cosa fa questa persona?\p"
	.string "{FONT_MALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Il PROF. OAK avrà presto un suo\n"
	.string "programma radio.\p"
	.string "Si chiamerà IL SEMINARIO\n"
	.string "SUI POKéMON DEL PROF. OAK.$"

gFameCheckerFlavorText_Daisy0:: @ 0x81AD40C
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Che lavoro fa?\p"
	.string "{FONT_MALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Se mostri un POKéMON a DAISY,\n"
	.string "lei ti dice quanto le piace.\p"
	.string "A volte ti toeletta anche\n"
	.string "un POKéMON.$"

gFameCheckerFlavorText_Daisy1:: @ 0x81AD4AE
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Che tipo è?\p"
	.string "{FONT_FEMALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Ma chi è più amata dai POKéMON\n"
	.string "credo sia DAISY.$"

gFameCheckerFlavorText_Daisy2:: @ 0x81AD516
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Che tipo è?\p"
	.string "{FONT_MALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Toelettava i POKéMON con dolcezza…\n"
	.string "Era un angioletto.\p"
	.string "Il nome di quella bambina…\n"
	.string "Mi pare fosse DAISY.$"

gFameCheckerFlavorText_Daisy3:: @ 0x81AD5A7
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Famiglia e amici?\p"
	.string "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Il PROF. OAK vive coi nipoti,\n"
	.string "DAISY e {RIVAL}.$"

gFameCheckerFlavorText_Daisy4:: @ 0x81AD608
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Che tipo è?\p"
	.string "{FONT_FEMALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}DAISY, una ragazza di BIANCAVILLA,\n"
	.string "beve Tè ogni giorno.\p"
	.string "Va al CENTRO COMMERCIALE di\n"
	.string "AZZURROPOLI a comprare il Tè.$"

gFameCheckerFlavorText_Daisy5:: @ 0x81AD69F
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Gira una voce…\p"
	.string "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}La campionessa del CONCORSO\n"
	.string "POKéMON di primavera è DAISY OAK di\l"
	.string "BIANCAVILLA!$"

gFameCheckerFlavorText_Brock0:: @ 0x81AD705
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Che lavoro fa?\p"
	.string "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}PALESTRA POKéMON DI PLUMBEOPOLI\n"
	.string "CAPO: BROCK\l"
	.string "L'allenatore roccioso!$"

gFameCheckerFlavorText_Brock1:: @ 0x81AD771
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}POKéMON preferiti?\p"
	.string "{FONT_MALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}La mia volontà di roccia si vede\n"
	.string "anche nei miei POKéMON.\p"
	.string "Sono tutti duri come pietre e\n"
	.string "hanno una gran determinazione.\p"
	.string "Esatto: i miei POKéMON sono\n"
	.string "tutti di tipo ROCCIA!$"

gFameCheckerFlavorText_Brock2:: @ 0x81AD840
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Che tipo è?\p"
	.string "{FONT_MALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Qui non ci sono molti allenatori\n"
	.string "POKéMON seri.\p"
	.string "Sono tutti PIGLIAMOSCHE,\n"
	.string "sai, semplici hobbisti.\p"
	.string "Ma BROCK della palestra di\n"
	.string "PLUMBEOPOLI non è così.$"

gFameCheckerFlavorText_Brock3:: @ 0x81AD908
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Che tipo è?\p"
	.string "{FONT_MALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}BROCK è forte, e non solo di muscoli.\n"
	.string "La gente lo stima e gli vuole bene.\p"
	.string "Voglio diventare CAPOPALESTRA\n"
	.string "come lui.$"

gFameCheckerFlavorText_Brock4:: @ 0x81AD99A
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Che lavoro fa?\p"
	.string "{FONT_MALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Ciao, scavo fossili qui sotto\n"
	.string "il MONTE LUNA.\p"
	.string "A volte BROCK della palestra di\n"
	.string "PLUMBEOPOLI mi dà una mano.$"

gFameCheckerFlavorText_Brock5:: @ 0x81ADA27
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Che tipo è?\p"
	.string "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}BROCK ride di rado, ma dicono che\n"
	.string "poi non riesca più a smettere.$"

gFameCheckerFlavorText_Misty0:: @ 0x81ADA91
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Cosa fa questa persona?\p"
	.string "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}PALESTRA POKéMON di\n"
