	.string "un gran sorriso.$"

gFameCheckerFlavorText_Blaine5:: @ 0x81AEB69
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Gira una voce…\p"
	.string "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Si dice che BLAINE tolga gli\n"
	.string "occhiali scuri solo quando pensa a\l"
	.string "nuove domande per il quiz.$"

gFameCheckerFlavorText_Lorelei0:: @ 0x81AEBDF
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Cosa fa questa persona?\p"
	.string "{FONT_FEMALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Sono LORELEI dei SUPERQUATTRO.$"

gFameCheckerFlavorText_Lorelei1:: @ 0x81AEC28
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Tipo di POKéMON preferito?\p"
	.string "{FONT_FEMALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Con i POKéMON di ghiaccio\n"
