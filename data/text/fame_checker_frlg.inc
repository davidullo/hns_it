	.string "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Nota per lo stile logico,\n"
	.string "calcolato e freddo, LORELEI\l"
	.string "ha un segreto sorprendente!$"

gFameCheckerFlavorText_Lorelei4:: @ 0x81AEDAA
