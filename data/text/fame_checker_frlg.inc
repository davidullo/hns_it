gFameCheckerFlavorText_Blaine0:: @ 0x81AE89E
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Cosa fa questa persona?\p"
	.string "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}PALESTRA POKéMON DI ISOLA CANNELLA\n"
	.string "CAPO: BLAINE\l"
