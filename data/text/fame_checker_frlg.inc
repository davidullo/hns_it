PokemonJournal_Text_SpecialFeatureBrock::
	.string "AGENDA POKéMON\p"
	.string "Speciale: PALESTRA di PLUMBEOPOLI\n"
	.string "CAPOPALESTRA BROCK!\p"
	.string "BROCK ride di rado, ma se inizia\n"
	.string "si dice che non riesca più a fermarsi.$"

PokemonJournal_Text_SpecialFeatureMisty::
	.string "AGENDA POKéMON\p"
	.string "Speciale: PALESTRA di CELESTOPOLI\n"
	.string "CAPOPALESTRA MISTY!\p"
	.string "Si dice che MISTY adori LORELEI\n"
	.string "dei SUPERQUATTRO.$"

PokemonJournal_Text_SpecialFeatureLtSurge::
	.string "AGENDA POKéMON\p"
	.string "Speciale: PALESTRA di ARANCIOPOLI\n"
	.string "CAPOPALESTRA LT. SURGE!\p"
	.string "Si dice che LT. SURGE sia stato\n"
	.string "un pilota in America.\p"
	.string "Usava l'elettricità dei POKéMON\n"
	.string "per alimentare il suo aereo.$"

PokemonJournal_Text_SpecialFeatureErika::
	.string "AGENDA POKéMON\p"
	.string "Speciale: PALESTRA di AZZURROPOLI\n"
	.string "CAPOPALESTRA ERIKA!\p"
	.string "Dicono che sbirciando nella\n"
	.string "PALESTRA di AZZURROPOLI si veda\l"
	.string "spesso ERIKA che sonnecchia.$"

PokemonJournal_Text_SpecialFeatureKoga::
	.string "AGENDA POKéMON\p"
	.string "Speciale: PALESTRA di FUCSIAPOLI\n"
	.string "CAPOPALESTRA KOGA!\p"
	.string "Si dice che KOGA abbia una profonda\n"
	.string "conoscenza della medicina.\p"
	.string "Prepara persino medicine per curare\n"
	.string "i suoi POKéMON.$"

PokemonJournal_Text_SpecialFeatureSabrina::
	.string "AGENDA POKéMON\p"
	.string "Speciale: PALESTRA di ZAFFIROPOLI\n"
	.string "CAPOPALESTRA SABRINA!\p"
	.string "Dicono che SABRINA possa\n"
	.string "comunicare con i suoi POKéMON\l"
	.string "in lotta senza parlare.$"

PokemonJournal_Text_SpecialFeatureBlaine::
	.string "AGENDA POKéMON\p"
	.string "Speciale: PALESTRA di ISOLA CANNELLA\n"
	.string "CAPOPALESTRA BLAINE!\p"
	.string "Si dice che BLAINE tolga gli occhiali\n"
	.string "scuri solo quando pensa a nuove\l"
	.string "domande per il quiz.$"

PokemonJournal_Text_SpecialFeatureLorelei::
	.string "AGENDA POKéMON\p"
	.string "Servizio speciale:\n"
	.string "LORELEI dei SUPERQUATTRO!\p"
	.string "Nota per lo stile logico, calcolato\n"
	.string "e freddo, LORELEI ha un\l"
	.string "sorprendente segreto!$"

PokemonJournal_Text_SpecialFeatureBruno::
	.string "AGENDA POKéMON\p"
	.string "Servizio speciale:\n"
	.string "BRUNO dei SUPERQUATTRO!\p"
	.string "BRUNO si è unito ai SUPERQUATTRO\n"
	.string "per l'ardente desiderio di sfidare\l"
	.string "i migliori ALLENATORI.$"

PokemonJournal_Text_SpecialFeatureAgatha::
	.string "AGENDA POKéMON\p"
	.string "Servizio speciale:\n"
	.string "AGATHA dei SUPERQUATTRO!\p"
	.string "Da giovane, AGATHA e il PROF.\n"
	.string "OAK erano rivali che si sfidavano\l"
	.string "per essere i migliori ALLENATORI.$"

PokemonJournal_Text_SpecialFeatureLance::
	.string "AGENDA POKéMON\p"
	.string "Servizio speciale:\n"
	.string "LANCE dei SUPERQUATTRO!\p"
	.string "Si pensa che il nonno di LANCE sia\n"
	.string "l'anziano di un famoso clan di\l"
	.string "domatori di draghi.$"

PokemonJournal_Text_SpecialFeatureProfOak::
	.string "AGENDA POKéMON\p"
	.string "Speciale: PROF. OAK,\n"
	.string "il Ricercatore POKéMON!\p"
	.string "Si dice che il PROF. OAK viva con i\n"
	.string "nipoti DAISY e {RIVAL}.$"

PokemonJournal_Text_SpecialFeatureDaisyOak::
	.string "Questa è un'AGENDA POKéMON di\n"
	.string "anni fa…\p"
	.string "AGENDA POKéMON\n"
	.string "Speciale GARA!\p"
	.string "La Gran Campionessa della GARA\n"
	.string "POKéMON di primavera è DAISY OAK\l"
	.string "di BIANCAVILLA!$"

PokemonJournal_Text_SpecialFeatureMrFuji::
	.string "AGENDA POKéMON\p"
	.string "Servizio speciale:\n"
	.string "MR. FUJI della CASA POKéMON!\p"
	.string "Redazione: il timido MR. FUJI ha\n"
	.string "rifiutato la nostra intervista.\p"
	.string "È un uomo gentile, amato\n"
	.string "e rispettato a LAVANDONIA.$"
