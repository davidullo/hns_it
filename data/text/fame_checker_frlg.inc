gFameCheckerFlavorText_LtSurge3:: @ 0x81ADE82
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Come è questa persona?\p"
	.string "{FONT_MALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}LT. SURGE era famoso\n"
	.string "per la sua prudenza nell'esercito.$"

gFameCheckerFlavorText_LtSurge4:: @ 0x81ADEEC
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Come è questa persona?\p"
	.string "{FONT_MALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}LT. SURGE installò le trappole\n"
	.string "della PALESTRA di persona.\p"
	.string "Mise doppie serrature ovunque.$"

gFameCheckerFlavorText_LtSurge5:: @ 0x81ADF6A
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Gira una voce…\p"
	.string "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Si dice che LT. SURGE sia stato\n"
