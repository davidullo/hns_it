gFameCheckerFlavorText_Misty2:: @ 0x81ADB5A
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Come è questa persona?\p"
	.string "{FONT_MALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}MISTY è un'ALLENATRICE che\n"
	.string "continuerà a migliorare.\p"
	.string "Non perderà con uno come te!$"

gFameCheckerFlavorText_Misty3:: @ 0x81ADBD9
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Gira una voce…\p"
	.string "{FONT_MALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}ALLENATORI forti e POKéMON\n"
	.string "d'ACQUA sono comuni da queste parti.\p"
	.string "Dicono che MISTY della PALESTRA\n"
	.string "di CELESTOPOLI si alleni qui.$"

gFameCheckerFlavorText_Misty4:: @ 0x81ADC72
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Corre voce…\p"
	.string "{FONT_FEMALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Questo capo è un famoso luogo d'incontri.\p"
	.string "MISTY, la CAPOPALESTRA, ci tiene\n"
	.string "molto a questo posto.$"

gFameCheckerFlavorText_Misty5:: @ 0x81ADCEB
	.string "{COLOR BLUE}{SHADOW LIGHT_BLUE}Gira una voce…\p"
	.string "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Si dice che MISTY adori LORELEI\n"
	.string "dei SUPERQUATTRO.$"

gFameCheckerFlavorText_LtSurge0:: @ 0x81ADD3C
