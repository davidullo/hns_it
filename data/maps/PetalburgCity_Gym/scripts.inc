	releaseall
	end

PetalburgCity_Gym_Text_DadYoureHereWithYourPokemon:
	.string "PAPÀ: Hm?\p"
	.string "Ma guarda, {PLAYER}!\n"
	.string "Hai finito il trasloco?\p"
	.string "Mi sorprende che tu sia\n"
	.string "arrivato fin qui da solo.\p"
	.string "Ah, capisco.\n"
	.string "Sei con i tuoi POKéMON.\p"
	.string "Hm… Allora diventerai\n"
	.string "un ALLENATORE come me, {PLAYER}.\p"
	.string "Che bella notizia!\n"
	.string "Non vedo l'ora!$"

PetalburgCity_Gym_Text_WallyIdLikeAPokemon:
	.string "Ehm… Io…\n"
	.string "Vorrei un POKéMON, per favore…$"

PetalburgCity_Gym_Text_DadOhYoureWallyRight:
	.string "PAPÀ: Hm? Tu sei… Ehm… Ah, giusto.\n"
	.string "Tu sei LINO, vero?$"

PetalburgCity_Gym_Text_WallyIveNeverCaughtAPokemon:
	.string "LINO: Andrò a stare dai miei\n"
	.string "parenti a VERDANTURF.\p"
	.string "Pensavo che da solo mi sentirei solo,\n"
	.string "quindi volevo portare un POKéMON.\p"
	.string "Ma non ho mai catturato un POKéMON.\n"
	.string "Non so come si fa…$"

PetalburgCity_Gym_Text_DadHmISee:
	.string "PAPÀ: Hm. Capisco.$"

PetalburgCity_Gym_Text_DadPlayerGoWithWally:
	.string "PAPÀ: {PLAYER}, hai sentito,\n"
	.string "vero?\p"
	.string "Vai con LINO e assicurati che\n"
	.string "catturi un POKéMON senza rischi.$"

PetalburgCity_Gym_Text_IllLoanYouMyZigzagoon:
	.string "LINO, ti presto un mio POKéMON.\p"
	.string "LINO riceve un ZIGZAGOON!$"

PetalburgCity_Gym_Text_WallyThankYouAndDadGivesPokeBall:
	.string "LINO: Oh, wow!\n"
	.string "Un POKéMON!\p"
	.string "PAPÀ: Hm. Ti do anche una POKé BALL.\n"
	.string "Provaci!\p"
	.string "LINO riceve una POKé BALL!$"

PetalburgCity_Gym_Text_WallyOhWowThankYou:
	.string "LINO: Oh, wow!\n"
	.string "Grazie!$"

PetalburgCity_Gym_Text_WouldYouReallyComeWithMe:
	.string "{PLAYER}… Verresti davvero\n"
	.string "con me?$"

PetalburgCity_Gym_Text_DadSoDidItWorkOut:
	.string "PAPÀ: Allora, è andata bene?$"

PetalburgCity_Gym_Text_WallyThankYouBye:
	.string "LINO: Grazie, sì, ci sono riuscito.\n"
	.string "Ecco il tuo POKéMON.\p"
	.string "{PLAYER}, grazie per essere venuto\n"
	.string "con me.\p"
	.string "È grazie a voi due se ho potuto\n"
	.string "catturare il mio POKéMON.\p"
	.string "Prometto che me ne prenderò\n"
	.string "molto cura.\p"
	.string "Oh! Mia mamma mi aspetta,\n"
	.string "quindi devo andare!\p"
	.string "Ciao, {PLAYER}!$"

PetalburgCity_Gym_Text_DadGoCollectBadges:
	.string "PAPÀ: Dunque…\p"
	.string "{PLAYER}, se vuoi diventare un\n"
	.string "forte ALLENATORE, ecco un consiglio.\p"
	.string "Vai a FERRUGIPOLI, oltre questa\n"
	.string "città.\p"
	.string "Là dovresti sfidare\n"
	.string "il CAPO PALESTRA, PETRA.\p"
	.string "Dopo di lei, vai nelle altre PALESTRE\n"
	.string "POKéMON e batti i loro CAPI.\p"
	.string "Colleziona le MEDAGLIE,\n"
	.string "intesi?\p"
	.string "Certo, anch'io sono un CAPO PALESTRA.\n"
	.string "Ci sfideremo un giorno, {PLAYER}.\p"
	.string "Ma solo dopo che sarai diventato\n"
	.string "più forte.$"

PetalburgCity_Gym_Text_NormanGoToRustboro:
	.string "PAPÀ: Eh? Non vai alla\n"
	.string "PALESTRA POKéMON di RUSTBORO?\p"
	.string "Non ha senso per me\n"
	.string "sfidare un ALLENATORE novellino.\p"
	.string "{PLAYER}, voglio che mi sfidi\n"
	.string "quando sarai molto più forte.\p"
	.string "Ti sfiderò, {PLAYER}, quando\n"
	.string "avrai quattro MEDAGLIE, okay?$"

PetalburgCity_Gym_Text_NormanGoToDewford:
	.string "PAPÀ: Capisco… Quindi hai battuto\n"
	.string "il CAPOPALESTRA di RUSTBORO.\p"
	.string "Ma ci sono molti altri ALLENATORI\n"
	.string "più forti di te, {PLAYER}.\p"
	.string "Oltre il mare, a DEWFORD c'è un\n"
	.string "CAPOPALESTRA di nome RUDI.\p"
	.string "Dovresti andare a sfidarlo.$"

PetalburgCity_Gym_Text_YouHaveGottenStronger:
	.string "PAPÀ: Hm… {PLAYER}, sei diventato\n"
	.string "più forte.\p"
	.string "Lo capisco dal numero di MEDAGLIE\n"
	.string "che hai conquistato.$"

PetalburgCity_Gym_Text_NormanIntro:
	.string "PAPÀ: Hm…\n"
	.string "Quindi hai preso quattro MEDAGLIE.\p"
	.string "Bene, come promesso, faremo\n"
	.string "una lotta POKéMON.\p"
	.string "{PLAYER}…\p"
	.string "Sono felice di poter fare\n"
	.string "una vera lotta con mio figlio.\p"
	.string "Ma una lotta è una lotta!\p"
	.string "Darò tutto me stesso come\n"
	.string "CAPOPALESTRA per vincere.\p"
	.string "{PLAYER}, dai il meglio\n"
	.string "anche tu!$"

PetalburgCity_Gym_Text_NormanDefeat:
	.string "…\p"
	.string "Io… non ci credo…\p"
	.string "Non ci credo. {PLAYER}…\p"
	.string "Ho perso contro {PLAYER}?\p"
	.string "Ma le regole sono regole!\n"
	.string "Tieni, prendi questo.$"

PetalburgCity_Gym_Text_ReceivedBalanceBadge:
	.string "{PLAYER} riceve la MEDAGLIA EQUILIBRIO\n"
	.string "da PAPÀ!$"

PetalburgCity_Gym_Text_ExplainBalanceBadgeTakeThis:
	.string "PAPÀ: Con quella MEDAGLIA, la DIFESA\n"
	.string "di tutti i tuoi POKéMON aumenterà.\p"
	.string "I POKéMON che conoscono SURF\n"
	.string "potranno viaggiare sull'acqua.\p"
	.string "È il mio regalo per te. {PLAYER}, so\n"
	.string "che saprai usarlo bene.$"

PetalburgCity_Gym_Text_ExplainFacade:
	.string "PAPÀ: La MT42 contiene FACCIATA.\p"
	.string "Raddoppia la potenza delle mosse se\n"
	.string "il POKéMON è avvelenato, paralizzato\l"
	.string "o scottato.\p"
	.string "Potrebbe trasformare una brutta\n"
	.string "situazione in un vantaggio.$"

PetalburgCity_Gym_Text_DadHappyAndSad:
	.string "PAPÀ: Come CAPO PALESTRA, non so\n"
	.string "dire quanto mi dispiaccia…\p"
	.string "Ma come padre, mi rende sia\n"
	.string "felice che un po' triste. Che strano…$"

PetalburgCity_Gym_Text_PleaseComeWithMe:
	.string "Ah, eccoti, {PLAYER}{KUN}!\p"
	.string "Vieni con me.\n"
	.string "Ho una cosa per te.$"

PetalburgCity_Gym_Text_LetMeBorrowPlayer:
	.string "NORMAN, non ti dispiace, vero?\p"
	.string "Fammi prendere in prestito {PLAYER}{KUN} per\n"
	.string "un minuto o due.$"

PetalburgCity_Gym_Text_DadGoingToKeepTraining:
	.string "PAPÀ: {PLAYER}, dovresti andare a trovare\n"
	.string "tua madre ogni tanto.\p"
	.string "Io resto qui e raddoppio\n"
	.string "l'allenamento.\p"
	.string "Come ALLENATORE mi darebbe fastidio\n"
	.string "non vendicare la sconfitta, {PLAYER}!$"

PetalburgCity_Gym_Text_DadNoAmountOfTrainingIsEnough:
	.string "PAPÀ: {PLAYER}, come va?\p"
	.string "Il mondo dei POKéMON è profondo.\p"
	.string "Credo davvero che nessun tipo di\n"
	.string "allenamento sia mai abbastanza.$"

PetalburgCity_Gym_Text_GymGuideAdvice:
	.string "Ehi, come va, futuro CAMPIONE\n"
	.string "{PLAYER}?\p"
	.string "In questa PALESTRA le porte si aprono\n"
	.string "battendo gli ALLENATORI.\p"
	.string "Ops! Le porte di questa sala sono\n"
	.string "già aperte, non attaccarmi!\p"
	.string "Gli ALLENATORI della PALESTRA di\n"
	.string "PETALBURG usano ogni tipo di oggetto.\p"
	.string "La porta a sinistra porta alla\n"
	.string "SALA VELOCITÀ.\p"
	.string "La porta a destra porta alla\n"
	.string "SALA PRECISIONE.\p"
	.string "Il nome della sala è scritto\n"
	.string "sulla porta, scegli bene.\p"
	.string "Una volta scelta la porta…\n"
	.string "Beh, ehi, vai e spacca tutto!$"

PetalburgCity_Gym_Text_GymGuidePostVictory:
	.string "{PLAYER}! Wow! Hai battuto persino\n"
	.string "tuo padre!\p"
	.string "Cioè, wow!\n"
	.string "Che svolta incredibile!$"

PetalburgCity_Gym_Text_RandallIntro:
	.string "La capacità di attaccare prima\n"
	.string "dell'avversario…\p"
	.string "Solo questo mi dà un grande\n"
	.string "vantaggio, non credi?$"

PetalburgCity_Gym_Text_RandallDefeat:
	.string "Che lotta magnifica!$"

PetalburgCity_Gym_Text_RandallPostBattle:
	.string "Vai nella prossima sala, dove ti\n"
	.string "aspetta una nuova sfida.\p"
	.string "A sinistra la SALA CONFUSIONE.\p"
	.string "La porta a destra porta alla SALA\n"
	.string "DIFESA.$"

PetalburgCity_Gym_Text_RandallPostBadge:
	.string "Chiunque tu batta, e chiunque\n"
	.string "possa batterti, non ti sottrai mai\l"
	.string "ad allenare te e i tuoi POKéMON.\p"
	.string "Ecco cosa significa essere un\n"
	.string "CAPOPALESTRA, per me.$"

PetalburgCity_Gym_Text_ParkerIntro:
	.string "Questa è la SALA CONFUSIONE.\p"
	.string "Vediamo quanto siete legati\n"
	.string "ai vostri POKéMON!$"

PetalburgCity_Gym_Text_ParkerDefeat:
	.string "Non ho confuso abbastanza la squadra…\n"
	.string "Siete legati da un forte affetto.$"

PetalburgCity_Gym_Text_ParkerPostBattle:
	.string "La prossima è la SALA FORZA.\n"
	.string "Resisti alla forza bruta?$"

PetalburgCity_Gym_Text_ParkerPostBadge:
	.string "Dopo che hai battuto il CAPO,\n"
	.string "l'allenamento è molto più duro.$"

PetalburgCity_Gym_Text_GeorgeIntro:
	.string "Proprio quando credi di\n"
	.string "vincere, l'avversario recupera PS…\p"
	.string "Immagini quanto può essere\n"
	.string "terribile?\p"
	.string "Ti mostrerò esattamente quanto\n"
	.string "è terribile!$"

PetalburgCity_Gym_Text_GeorgeDefeat:
	.string "Non ho potuto recuperare abbastanza PS…\n"
	.string "Che potenza d'ATTACCO…$"

PetalburgCity_Gym_Text_GeorgePostBattle:
	.string "Non mi aspettavo di meno dal\n"
	.string "figlio del nostro CAPO.\p"
	.string "No, aspetta! Le capacità di un\n"
	.string "ALLENATORE si conquistano.\p"
	.string "Ho perso perché i miei sforzi\n"
	.string "non sono bastati.\p"
	.string "Vai! Ora c'è la SALA KO IN UN COLPO.$"

PetalburgCity_Gym_Text_GeorgePostBadge:
	.string "Continuerò ad allenarmi nelle PALESTRE.\n"
	.string "Un giorno diventerò un CAPO.$"

PetalburgCity_Gym_Text_BerkeIntro:
	.string "Non andrò piano solo\n"
	.string "perché sei il figlio del nostro CAPO.\p"
	.string "Ti mostrerò quanto è brutto per\n"
	.string "un POKéMON subire un brutto colpo!$"

PetalburgCity_Gym_Text_BerkeDefeat:
	.string "La tua forza…\n"
	.string "Sei davvero forte.$"

PetalburgCity_Gym_Text_BerkePostBattle:
	.string "Tuo padre è davvero forte.\n"
	.string "È un ALLENATORE che merita rispetto.\p"
	.string "E sento lo stesso bagliore che\n"
	.string "viene da te, come da tuo padre.\p"
	.string "Spero che combatterai una lotta\n"
	.string "fantastica con tuo padre!$"

PetalburgCity_Gym_Text_BerkePostBadge:
	.string "Da quando tuo padre è il CAPO,\n"
	.string "gli ALLENATORI di PETALBURG\l"
	.string "sono diventati molto più forti.$"

PetalburgCity_Gym_Text_MaryIntro:
	.string "Eh eh…\n"
	.string "Questa è la SALA PRECISIONE.\p"
	.string "È brutta quando ogni attacco\n"
	.string "va a segno senza sbagliare.$"

PetalburgCity_Gym_Text_MaryDefeat:
	.string "Eri di un altro livello…$"

PetalburgCity_Gym_Text_MaryPostBattle:
	.string "Ci sono ALLENATORI ancora più\n"
	.string "forti che ti aspettano.\p"
	.string "A sinistra la SALA DIFESA, e\n"
	.string "a destra la SALA RECUPERO.\p"
	.string "La potenza d'ATTACCO dei POKéMON sarà\n"
	.string "messa alla prova in ogni caso.$"

PetalburgCity_Gym_Text_MaryPostBadge:
	.string "Sai cosa cerchiamo di\n"
	.string "ottenere come ALLENATORI?\p"
	.string "Vogliamo diventare anime gemelle\n"
	.string "dei nostri POKéMON.$"

PetalburgCity_Gym_Text_AlexiaIntro:
	.string "Più alta è la DIFESA, più\n"
	.string "temeraria posso essere in attacco.$"

PetalburgCity_Gym_Text_AlexiaDefeat:
	.string "Le nostre difese non sono bastate…$"

PetalburgCity_Gym_Text_AlexiaPostBattle:
	.string "Credo che mi hai insegnato una bella\n"
	.string "lezione.\p"
	.string "Ora vai! La porta a sinistra porta\n"
	.string "alla SALA FORZA.\p"
	.string "La porta a destra si apre sulla\n"
	.string "SALA KO IN UN COLPO.\p"
	.string "In entrambe ci sono ALLENATORI\n"
	.string "esperti in attacco.$"

PetalburgCity_Gym_Text_AlexiaPostBadge:
	.string "Ciao! Hai provato a usare SURF?$"

PetalburgCity_Gym_Text_JodyIntro:
	.string "Il nostro CAPOPALESTRA ci ha detto\n"
	.string "di dare il massimo e batterti.\p"
	.string "Anche se sei il figlio\n"
	.string "del CAPO!$"

PetalburgCity_Gym_Text_JodyDefeat:
	.string "Ma… ce l'ho messa tutta!$"

PetalburgCity_Gym_Text_JodyPostBattle:
	.string "Il modo in cui usi i POKéMON…\n"
	.string "È come lo stile di tuo padre.\p"
	.string "Vai avanti! Il CAPOPALESTRA, tuo\n"
	.string "padre, ti aspetta!$"

PetalburgCity_Gym_Text_JodyPostBadge:
	.string "Certo, va bene rendere i POKéMON\n"
	.string "più forti.\p"
	.string "Ma cosa decide il vincitore?\p"
	.string "Ma dai, sono i sentimenti che gli\n"
	.string "ALLENATORI provano per i POKéMON.$"

PetalburgCity_Gym_Text_DoorAppearsLocked:
	.string "Questa porta sembra bloccata\n"
	.string "per ora…$"

PetalburgCity_Gym_Text_EnterSpeedRoom:
	.string "“SALA VELOCITÀ”, dice il cartello.\p"
	.string "Vuoi passare?$"

@ Unused
PetalburgCity_Gym_Text_DoorAppearsLocked2:
	.string "Questa porta sembra bloccata\n"
	.string "per ora…$"

PetalburgCity_Gym_Text_EnterAccuracyRoom:
	.string "“SALA PRECISIONE”, dice il cartello.\p"
	.string "Vuoi entrare?$"

PetalburgCity_Gym_Text_EnterConfusionRoom:
	.string "“SALA CONFUSIONE”, dice il cartello.\p"
	.string "Vuoi entrare?$"

PetalburgCity_Gym_Text_EnterDefenseRoom:
	.string "“SALA DIFESA”, dice il cartello.\p"
	.string "Vuoi entrare?$"

PetalburgCity_Gym_Text_EnterRecoveryRoom:
	.string "“SALA RECUPERO”, dice il cartello.\p"
	.string "Vuoi passare?$"

PetalburgCity_Gym_Text_EnterStrengthRoom:
	.string "“SALA FORZA”, dice il cartello.\p"
	.string "Vuoi passare?$"

PetalburgCity_Gym_Text_EnterOHKORoom:
	.string "“SALA KO IN UN COLPO”, dice il cartello.\p"
	.string "Vuoi passare?$"

PetalburgCity_Gym_Text_EnterGymLeadersRoom:
	.string "“SALA DEL CAPO PALESTRA\p"
	.string "“Scopri da te quali POKéMON\n"
	.string "ti attendono!” dice il cartello.\p"
	.string "Vuoi entrare?$"

PetalburgCity_Gym_Text_GymStatue:
	.string "PALESTRA POKéMON DI PETALBURG$"

PetalburgCity_Gym_Text_GymStatueCertified:
	.string "PALESTRA POKéMON DI PETALBURG\p"
	.string "ALLENATORI CERTIFICATI DI NORMAN:\n"
	.string "{PLAYER}$"

PetalburgCity_Gym_Text_NormanPreRematch:
	.string "PAPÀ: {PLAYER}…\n"
	.string "Sentivo che saresti venuto.\p"
	.string "Non rifiuterei mai di accettare\n"
	.string "una sfida da te.\p"
	.string "Lo capisci, vero?\p"
	.string "Dentro una PALESTRA non conta che\n"
	.string "siamo genitore e figlio.\p"
	.string "…No, proprio perché lo siamo,\n"
	.string "ci dobbiamo a vicenda il massimo\l"
	.string "impegno. Giusto, {PLAYER}?$"

PetalburgCity_Gym_Text_NormanRematchDefeat:
	.string "Uh… Ah ah…\n"
	.string "Forse ho esagerato…$"

PetalburgCity_Gym_Text_NormanPostRematch:
	.string "PAPÀ: {PLAYER}…\n"
	.string "Qual è il tuo sogno?\p"
	.string "Il mio sogno…\n"
	.string "Ah ah ah…\l"
	.string "Si è già avverato, in realtà.$"

PetalburgCity_Gym_Text_NormanRematchNeedTwoMons:
	.string "PAPÀ: {PLAYER}…\n"
	.string "Sentivo che saresti venuto.\p"
	.string "Non rifiuterei mai di accettare\n"
	.string "una sfida da te.\p"
	.string "Lo capisci, vero?\p"
	.string "Dentro una PALESTRA non conta che\n"
	.string "siamo genitore e figlio.\p"
	.string "Hm? Aspetta un attimo, {PLAYER}.\p"
	.string "Hai solo un POKéMON in grado\n"
	.string "di lottare?\p"
	.string "Scusa, ma dovrai tornare\n"
	.string "con almeno due POKéMON.$"

