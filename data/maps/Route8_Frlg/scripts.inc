Route8_Frlg_MapScripts::
	.byte 0

Route8_EventScript_UndergroundPathSign::
	msgbox Route8_Text_UndergroundPathSign, MSGBOX_SIGN
	end

Route8_Text_AidanIntro::
	.string "Sembri forte coi POKéMON, ma in\n"
	.string "chimica come stai?$"

Route8_Text_AidanDefeat::
	.string "Ahia!\n"
	.string "Che disastro!$"

Route8_Text_AidanPostBattle::
	.string "A scuola sono molto meglio!$"

Route8_Text_StanIntro::
	.string "Bene!\n"
	.string "Facciamo una partita!$"

Route8_Text_StanDefeat::
	.string "Accidenti!\n"
	.string "Non ce l'ho fatta!$"

Route8_Text_StanPostBattle::
	.string "Oggi non è andata.$"

Route8_Text_GlennIntro::
	.string "Dovresti essere informato.\n"
	.string "Serve strategia per vincere!$"

Route8_Text_GlennDefeat::
	.string "Non è logico!$"

Route8_Text_GlennPostBattle::
	.string "Manda GRIMER per primo…e…\n"
	.string "…e…poi…$"

Route8_Text_PaigeIntro::
	.string "Adoro NIDORAN, li colleziono!$"

Route8_Text_PaigeDefeat::
	.string "Perché?\n"
	.string "Perché??$"

Route8_Text_PaigePostBattle::
	.string "Quando i POKéMON crescono diventano\n"
	.string "brutti! Non dovrebbero evolversi.$"

Route8_Text_LeslieIntro::
	.string "La scuola è bella, ma i POKéMON di più.$"

Route8_Text_LeslieDefeat::
	.string "Mi hai fatto capire che\n"
	.string "devo restare a scuola.$"

Route8_Text_LesliePostBattle::
	.string "Volevo prendere un po'\n"
	.string "d'aria per cambiare, ma…\p"
	.string "Siamo bloccati qui per i\n"
	.string "cancelli di ZAFFERANOPOLI.$"

Route8_Text_AndreaIntro::
	.string "MEOWTH è così tenero, miao, miao,\n"
	.string "miao!$"

Route8_Text_AndreaDefeat::
	.string "Miao miao!$"

Route8_Text_AndreaPostBattle::
	.string "Anche PIDGEY e RATTATA sono\n"
	.string "teneri!$"

Route8_Text_MeganIntro::
	.string "Dobbiamo sembrare ridicoli\n"
	.string "così.$"

Route8_Text_MeganDefeat::
	.string "Guarda cosa hai fatto al mio\n"
	.string "povero POKéMON carino!$"

Route8_Text_MeganPostBattle::
	.string "Il guardiano di ZAFFERANOPOLI non ci\n"
	.string "fa passare.\p"
	.string "So che fa il suo lavoro, ma\n"
	.string "per me è stronzo.$"

Route8_Text_RichIntro::
	.string "Sono un tipo da giochi e giri!$"

Route8_Text_RichDefeat::
	.string "Occasione mancata!$"

Route8_Text_RichPostBattle::
	.string "Giochi e POKéMON sono come\n"
	.string "noccioline! Non riesco a smettere!$"

Route8_Text_JuliaIntro::
	.string "Qual è il POKéMON carino, tondo\n"
	.string "e Morbidone?$"

Route8_Text_JuliaDefeat::
	.string "Stop!\p"
	.string "Non essere cattivo con il mio CLEFAIRY!$"

Route8_Text_JuliaPostBattle::
	.string "Ho letto che CLEFAIRY si evolve\n"
	.string "con la PIETRALUNARE.\p"
	.string "L'ho letto sull'AGENDA POKéMON.\n"
	.string "Chissà se è vero?$"

Route8_Text_UndergroundPathSign::
	.string "VIA SOTTERRANEA\n"
	.string "AZZURROPOLI - LAVANDONIA$"

Route8_Text_EliIntro::
	.string "ELI: Il potere gemello è fantastico.\n"
	.string "Lo sapevi?$"

Route8_Text_EliDefeat::
	.string "ELI: Ma…\n"
	.string "Abbiamo usato il potere gemello…$"

Route8_Text_EliPostBattle::
	.string "ELI: Ho catturato i miei POKéMON con\n"
	.string "ANNE!$"

Route8_Text_EliNotEnoughMons::
	.string "ELI: Non possiamo lottare se non\n"
	.string "hai due POKéMON.$"

Route8_Text_AnneIntro::
	.string "ANNE: Ti colpiremo col nostro potere\n"
	.string "gemello!$"

Route8_Text_AnneDefeat::
	.string "ANNE: Il nostro potere gemello…$"

Route8_Text_AnnePostBattle::
	.string "ANNE: Sto allenando POKéMON con\n"
	.string "ELI.$"

Route8_Text_AnneNotEnoughMons::
	.string "ANNE: Ciao, ciao! Lottiamo!\n"
	.string "Ma porta due POKéMON.$"

Route8_Text_RicardoIntro::
	.string "La mia bici fa i capricci.$"

Route8_Text_RicardoDefeat::
	.string "Ah, cavolo.\n"
	.string "Non mi va.$"

Route8_Text_RicardoPostBattle::
	.string "Ho dell'erba tra i\n"
	.string "raggi.$"

Route8_Text_JarenIntro::
	.string "Fammi passare, o ti\n"
	.string "travolgo!$"

Route8_Text_JarenDefeat::
	.string "Dici sul serio, ragazzino?$"

Route8_Text_JarenPostBattle::
	.string "Non credere di essere speciale\n"
	.string "solo per questo.$"
